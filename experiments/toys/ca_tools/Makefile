# Makefile for building/running CA toy tools

.PHONY: build

build:
	@echo "Build is delegated to the top-level repository. Example compilation:" \
	 && echo "gcc experiments/toys/CA_4nPCA_012.c -o experiments/toys/universe_004_batch_04 -lSDL2 -lm"

.PHONY: run-example
run-example:
	@echo "Run an example batch (edit as needed)" \
	 && ./run_ca_batch.sh ./universe_004_batch_04 --batch 137 137 200
